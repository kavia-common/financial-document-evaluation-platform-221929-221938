# Backend environment variables
DEBUG=false
SECRET_KEY=change-me
# CORS: allow only the frontend origin
FRONTEND_ORIGIN=http://localhost:3000

# Upload limits and validation
MAX_UPLOAD_MB=10
# Comma-separated list of allowed content-types
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg

# The following are present in the container environment as reference for multi-container apps
REACT_APP_API_BASE=http://localhost:3001
REACT_APP_BACKEND_URL=http://localhost:3001
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:3001
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=1
REACT_APP_PORT=3001
REACT_APP_TRUST_PROXY=0
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=0
